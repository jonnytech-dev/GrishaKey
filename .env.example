# Required. Signs the session cookie. At least 32 characters; the app won't start with less.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
STORAGE_SECRET=

# Show a searchable list of registered users in share dialogs (true/false).
# Turn on for a single organization (church, company). Leave off on public installs,
# since it shows every user's name and email to anyone who can share.
USER_DIRECTORY=false

# APP BRANDING VALUES
APP_NAME="Grisha"
APP_NAME_ACCENT="Key"

# REGISTER / LOGIN ATTEMPT VALUES
MAX_FAILED_LOGIN_ATTEMPTS="10"
MAX_FAILED_REGISTER_ATTEMPTS="5"

# PASSWORD GENERATOR VALUES
MIN_LENGTH="8"
MAX_LENGTH="100"
MIN_WORDS="3"
MAX_WORDS="12"

# SESSION VALUES
TIMEOUT_SECONDS="15"        # in minutes
MAX_LIFETIME_SECONDS="12"   # in hours

# IMPORT CREDENTIALS VALUES
MAX_IMPORT_MB="2"           # in MB, MIN 1, MAX 10
MAX_IMPORT_ROWS="5000"      # MIN 1, MAX 5000

# HEALTH CHECK VALUES
STRONG_BITS="60"       # 60+ bits and not reused → strong
FAIR_BITS="40"         # 40–59 bits → Not strong enough; under 40 → weak