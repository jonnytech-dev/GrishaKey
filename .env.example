# Required. Signs the session cookie. At least 32 characters; the app won't start with less.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
STORAGE_SECRET=

# Show a searchable list of registered users in share dialogs (true/false).
# Turn on for a single organization (church, company). Leave off on public installs,
# since it shows every user's name and email to anyone who can share.
USER_DIRECTORY=false
